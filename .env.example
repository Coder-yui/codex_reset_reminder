# ============================================================
# reset_remind 本地配置文件
# 使用方法：cp .env.example .env，然后在下面填入你的值
# ============================================================

# ---------- 1. RSSHub 实例地址 ----------
# 你部署在 Render 上的 RSSHub 地址（部署完成后会拿到，先留空占位也行）
# 部署方法见下方"Render 部署"说明
# 示例：https://your-rsshub.onrender.com
RSSHUB_URL=

# ---------- 2. 监控的 X 用户名 ----------
# Tibo 的 X 用户名（不带 @）。已知是 thsottiaux，通常无需改
TWITTER_USERNAME=thsottiaux

# ---------- 3. DeepSeek API ----------
# 去 https://platform.deepseek.com 注册 → API Keys → 创建 key
# 你说已经有了，直接粘进来
DEEPSEEK_API_KEY=

# 模型名，默认 deepseek-v4-flash（便宜快），如要换 deepseek-v4-pro 再改
# 注意：deepseek-chat 和 deepseek-reasoner 已于 2026-07-24 停用
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- 4. 飞书自定义机器人 ----------
# 按上面回复里的步骤：桌面端建群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
# 复制 webhook 地址粘进来，形如：
# https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_WEBHOOK_URL=

# ---------- 5. 分类置信度阈值 ----------
# 0-1 之间，低于此值的 reset 信号不推送
# 0.5 = 平衡；0.7 = 严格少误报；0.3 = 敏感多推送
CONFIDENCE_THRESHOLD=0.5


# ============================================================
# Render 部署说明（不需要在这里填，是给你看步骤的）
# ============================================================
#
# 1. 去 https://render.com 注册（可用 GitHub 登录）
# 2. New → Web Service → 选 "Existing Image" 或 "Build from Docker Image"
# 3. Image 填：diygod/rsshub
# 4. Region 选 Singapore 或任意海外节点
# 5. Instance Type 选 Free
# 6. Environment Variables 填两个（值从你的 X 浏览器 cookie 拿，见下）：
#      TWITTER_AUTH_TOKEN = <你的 X auth_token cookie>
#      TWITTER_CT0        = <你的 X ct0 cookie>
#
# 获取 X cookie 的方法：
#   - 用 Chrome/Edge 登录 https://x.com
#   - F12 打开开发者工具 → Application 标签 → Cookies → https://x.com
#   - 找到 auth_token 和 ct0 两行，复制它们的 Value
#
# 部署完成后会拿到一个 URL，把它填到上面的 RSSHUB_URL 里
# 验证：浏览器访问 https://<你的地址>/twitter/user/thsottiaux，能看到 XML 就成了


# ============================================================
# GitHub Secrets 配置说明（同样不在本文件填）
# ============================================================
#
# 推到 GitHub 后，仓库 Settings → Secrets and variables → Actions → New secret
# 需要添加的 Secret（值和上面 .env 里填的一模一样）：
#
#   RSSHUB_URL             = <同上>
#   TWITTER_USERNAME       = thsottiaux
#   DEEPSEEK_API_KEY       = <同上>
#   DEEPSEEK_MODEL         = deepseek-chat
#   FEISHU_WEBHOOK_URL     = <同上>
#   CONFIDENCE_THRESHOLD   = 0.5
